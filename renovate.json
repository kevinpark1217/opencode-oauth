{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "customDatasources": {
    "opencode-effect": {
      "defaultRegistryUrlTemplate": "https://registry.npmjs.org/@opencode/plugin/latest",
      "transformTemplates": ["{\"releases\": [{\"version\": dependencies.effect}]}"]
    }
  },
  "customManagers": [
    {
      "description": "The effect devDependency, at the version the latest @opencode/plugin depends on. The \\d skips the peer range.",
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"(?<depName>effect)\": \"(?<currentValue>\\d[^\"]*)\""],
      "datasourceTemplate": "custom.opencode-effect",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "The custom manager above sets effect.",
      "matchManagers": ["bun"],
      "matchPackageNames": ["effect"],
      "enabled": false
    },
    {
      "description": "Peer ranges change by hand (CONTRIBUTING.md, Updating dependencies).",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "One pull request for the plugin API and effect, even across major versions.",
      "matchPackageNames": ["@opencode/plugin", "effect"],
      "groupName": "OpenCode host",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["bun", "@types/bun"],
      "groupName": "Bun"
    }
  ]
}
