{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "customDatasources": {
    "opencode-effect": {
      "defaultRegistryUrlTemplate": "https://registry.npmjs.org/@opencode/plugin/latest",
      "transformTemplates": ["{\"releases\": [{\"version\": dependencies.effect}]}"]
    }
  },
  "customManagers": [
    {
      "description": "The \\d skips the effect peer range.",
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"(?<depName>effect)\": \"(?<currentValue>\\d[^\"]*)\""],
      "datasourceTemplate": "custom.opencode-effect",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    { "matchManagers": ["bun"], "matchPackageNames": ["effect"], "enabled": false },
    { "matchDepTypes": ["peerDependencies"], "enabled": false },
    { "matchPackageNames": ["@opencode/plugin", "effect"], "groupName": "OpenCode host", "separateMajorMinor": false },
    { "matchPackageNames": ["bun", "@types/bun"], "groupName": "Bun" }
  ]
}
