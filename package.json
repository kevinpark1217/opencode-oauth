{
  "name": "opencode-oauth",
  "version": "0.1.0",
  "description": "OpenCode plugin: sign in to an OpenAI-compatible provider with OAuth 2.0 (authorization code with PKCE, refresh tokens), and search the web through a SearXNG behind the same sign-in",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "oauth",
    "oauth2",
    "pkce",
    "oidc",
    "searxng"
  ],
  "license": "MIT",
  "author": "Kevin Park",
  "homepage": "https://github.com/kevinpark1217/opencode-oauth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinpark1217/opencode-oauth.git"
  },
  "bugs": {
    "url": "https://github.com/kevinpark1217/opencode-oauth/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.32",
    "effect": "^4.0.1"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.4",
    "@types/bun": "1.4.4",
    "effect": "4.0.1",
    "typescript": "7.0.2"
  }
}
